# All values are optional. The site runs without any of them.

# Public URL, used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://portfolio.sanketmali.dev

# Server-only. Raises the GitHub API rate limit. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Server-only. Lets the contact form send mail through Resend.
# Without it, the form opens the visitor's mail app with the message filled in.
RESEND_API_KEY=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
